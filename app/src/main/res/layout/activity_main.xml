<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jarvis_bg"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/jarvis_card"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_jarvis"
            app:tint="@color/jarvis_cyan" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:text="JARVIS HUD"
                android:textColor="@color/jarvis_cyan"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvHeaderSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ovozli Ko‘prik &amp; Displey"
                android:textColor="@color/jarvis_text_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge"
            android:fontFamily="sans-serif-bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="OFFLINE"
            android:textColor="@color/jarvis_red"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Navigation Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/jarvis_card"
        app:tabIndicatorColor="@color/jarvis_cyan"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/jarvis_cyan"
        app:tabTextColor="@color/jarvis_text_dim">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📟 DISPLEY" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌐 WEB HUD" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ SOZLAMALAR" />
    </com.google.android.material.tabs.TabLayout>

    <!-- Main Container Switching Between Tabs -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- TAB 1: Live Display & Action Logs -->
        <LinearLayout
            android:id="@+id/tabLiveDisplay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Real-time HUD State Banner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                app:cardBackgroundColor="@color/jarvis_card"
                app:cardCornerRadius="10dp"
                app:strokeColor="@color/jarvis_dark_cyan"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLiveStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="Kutish holatida"
                            android:textColor="@color/jarvis_cyan"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvLiveSubStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Quloqchin mikrofoniga gapiring yoki matn yozing"
                            android:textColor="@color/jarvis_text_dim"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuickMic"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="🎤 Gapirish"
                        android:textColor="@color/jarvis_cyan"
                        android:textSize="12sp"
                        app:cornerRadius="8dp"
                        app:strokeColor="@color/jarvis_cyan" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Scrollable Log/Chat Feed -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLiveFeed"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />

            <!-- Empty Feed Placeholder -->
            <TextView
                android:id="@+id/tvEmptyFeed"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Hozircha amallar yo‘q.\nGapiring: «Jarvis, qo‘shiq qo‘y» yoki «Jarvis, xarajat qo‘sh»\nNatijalar shu yerda ko‘rinadi!"
                android:textColor="@color/jarvis_text_dim"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Bottom Command Input Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/jarvis_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <EditText
                    android:id="@+id/etCommandInput"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:hint="Jarvisga buyruq yozing..."
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/jarvis_text"
                    android:textColorHint="@color/jarvis_text_dim"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendCommand"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/jarvis_cyan"
                    android:text="Yuborish"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- TAB 2: Full Web HUD (WebView) -->
        <LinearLayout
            android:id="@+id/tabWebDisplay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/jarvis_card"
                android:gravity="center_vertical"
                android:padding="6dp">

                <TextView
                    android:id="@+id/tvWebUrl"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:text="http://100.112.86.116:8000"
                    android:textColor="@color/jarvis_text_dim"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReloadWeb"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🔄 Qayta yuklash"
                    android:textColor="@color/jarvis_cyan"
                    android:textSize="11sp" />
            </LinearLayout>

            <WebView
                android:id="@+id/webViewDashboard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/jarvis_bg" />
        </LinearLayout>

        <!-- TAB 3: Settings -->
        <ScrollView
            android:id="@+id/tabSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="KOMPYUTER SOZLAMALARI"
                    android:textColor="@color/jarvis_cyan"
                    android:textSize="14sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Kompyuter manzili (IP yoki Tailscale IP)"
                    android:textColorHint="@color/jarvis_text_dim"
                    app:boxBackgroundColor="@color/jarvis_card"
                    app:boxStrokeColor="@color/jarvis_cyan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etServerAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:text="100.112.86.116:8000"
                        android:textColor="@color/jarvis_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Xavfsizlik kaliti (Auth Token)"
                    android:textColorHint="@color/jarvis_text_dim"
                    app:boxBackgroundColor="@color/jarvis_card"
                    app:boxStrokeColor="@color/jarvis_cyan">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAuthToken"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:text="jarvis-phone-companion-token"
                        android:textColor="@color/jarvis_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <CheckBox
                    android:id="@+id/cbAutoStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:checked="true"
                    android:text="Telefon yoqilganda avtomatik ishga tushsin (Boot)"
                    android:textColor="@color/jarvis_text" />

                <CheckBox
                    android:id="@+id/cbContinuous"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="Doimiy eshitish (Continuous VAD)"
                    android:textColor="@color/jarvis_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleService"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/jarvis_cyan"
                    android:fontFamily="sans-serif-medium"
                    android:text="XIZMATNI ISHGA TUSHIRISH"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    app:cornerRadius="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:lineSpacingExtra="3dp"
                    android:text="ℹ️ Eslatma:\n• Bu ilovani ochib turish SHART EMAS — xizmat yoqilgach ekran o‘chsa ham ishlayveradi.\n• Bildirishnoma yoki Bluetooth quloqchin tugmasini bosib gapirish mumkin.\n• Jonli displey tabida JARVISning barcha harakatlari va javoblarini kuzatishingiz mumkin."
                    android:textColor="@color/jarvis_text_dim"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>

    </FrameLayout>
</LinearLayout>
