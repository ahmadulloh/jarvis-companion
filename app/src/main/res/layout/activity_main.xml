<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 1. Fullscreen Living Particle Intelligence Canvas -->
    <com.jarvis.companion.ui.JarvisParticleView
        android:id="@+id/jarvisParticleView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Minimalist Futuristic Top Bar (Constrained & Compact) -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:paddingStart="20dp"
        android:paddingTop="26dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <!-- Brand Title: J . A . R . V . I . S -->
        <TextView
            android:id="@+id/tvBrandTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/chipDomainSelector"
            android:layout_marginEnd="14dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.20"
            android:singleLine="true"
            android:text="J . A . R . V . I . S"
            android:textColor="#0B2A18"
            android:textSize="14sp" />

        <!-- Domain Mode Selector Chip (Click opens Bottom Sheet) -->
        <LinearLayout
            android:id="@+id/chipDomainSelector"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_domain_chip"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp">

            <!-- Small Round Colored Indicator Dot -->
            <View
                android:id="@+id/viewChipDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_sheet_handle" />

            <!-- Active Domain Title (Short & Compact) -->
            <TextView
                android:id="@+id/tvChipTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:maxWidth="115dp"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Asosiy"
                android:textColor="#12A550"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 3. Minimal Organic Status / Command Caption -->
    <TextView
        android:id="@+id/tvJarvisCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="60dp"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:alpha="0"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.02"
        android:lineSpacingExtra="3dp"
        android:text="«Onamga telefon qil»"
        android:textColor="#5D7A69"
        android:textSize="15sp" />

    <!-- 4. Optional Text Input Bar (Visible only when user enables in Settings) -->
    <LinearLayout
        android:id="@+id/bottomBarContainer"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_sheet_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/etCommandInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Buyruq yozing..."
            android:imeOptions="actionSend"
            android:inputType="text"
            android:textColor="#0B2A18"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnSendCommand"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Jo'natish"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_send"
            app:tint="#12A550" />
    </LinearLayout>

    <!-- 5. In-App Web View Container (Hidden by default, used for Quran recitation or web links) -->
    <RelativeLayout
        android:id="@+id/containerWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <RelativeLayout
            android:id="@+id/headerWebView"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#F8FAFC"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/tvWebTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="sans-serif-bold"
                android:text="Qur'on Ustozi"
                android:textColor="#0B2A18"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnOpenExternalBrowser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="Brauzerda ochish"
                    android:textColor="#12A550"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnCloseWebView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:padding="8dp"
                    android:text="Yopish ✕"
                    android:textColor="#64748B"
                    android:textSize="12sp" />
            </LinearLayout>
        </RelativeLayout>

        <WebView
            android:id="@+id/webViewDashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/headerWebView" />
    </RelativeLayout>

</RelativeLayout>
