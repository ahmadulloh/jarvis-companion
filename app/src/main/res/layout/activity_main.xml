<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/day_bg">

    <!-- Top iOS-style Minimal Header Bar (Matching Screenshot) -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.14"
            android:text="J.A.R.V.I.S"
            android:textColor="@color/day_text_primary"
            android:textSize="20sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ios_action_chip"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="● ALOQADA"
            android:textColor="@color/jarvis_accent"
            android:textSize="10sp" />

        <!-- Dynamic Domain Badge (Click opens 31 Domains) -->
        <TextView
            android:id="@+id/tvHeaderDomainBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_ios_pill_active"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="⚡ ASOSIY"
            android:textColor="@color/night_pill_active_text"
            android:textSize="10sp" />

        <!-- Theme Toggle -->
        <ImageButton
            android:id="@+id/btnThemeToggle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Mavzu"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_sun"
            app:tint="@color/day_text_secondary" />

        <!-- User Profile Avatar (Click to Login / Edit Profile) -->
        <FrameLayout
            android:id="@+id/layoutProfileAvatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp">

            <ImageView
                android:id="@+id/ivUserProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle_avatar"
                android:contentDescription="Profil"
                android:padding="2dp"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/ic_profile_default" />
        </FrameLayout>

        <!-- Settings Cog Button -->
        <ImageButton
            android:id="@+id/btnOpenSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Sozlamalar"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_settings"
            app:tint="@color/day_text_secondary" />
    </LinearLayout>

    <!-- Scrollable Center Body -->
    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomBarContainer"
        android:layout_below="@id/headerBar"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- Center AI Orb Arena (Full Width with Soundwave Bars) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="2dp">

                <com.jarvis.companion.ui.JarvisOrbView
                    android:id="@+id/jarvisOrb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <!-- Minimalist AI Status Text -->
            <TextView
                android:id="@+id/tvOrbStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:text="JARVIS TAYYOR"
                android:textColor="@color/jarvis_cyan"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvOrbSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="Labbay, Axmadulloh sir, eshitaman..."
                android:textColor="@color/day_text_secondary"
                android:textSize="12sp" />

            <!-- Qur'on Ustozi AI Card (Matches Screenshot! Gone by default, appears when requested) -->
            <LinearLayout
                android:id="@+id/cardQuronLesson"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_day_card"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <!-- Header with Title & Close button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="Quron"
                        app:srcCompat="@drawable/ic_quron" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvQuronTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.06"
                            android:text="QUR'ON USTOZI AI"
                            android:textColor="@color/day_text_primary"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvQuronInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Tajvid va qiroat o'rganish"
                            android:textColor="@color/day_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnCloseQuronCard"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center"
                        android:text="✕"
                        android:textColor="@color/day_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Action Buttons: DARSNI BOSHLASH and KUNLIK REJA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartQuron"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1.2"
                        android:backgroundTint="@null"
                        android:background="@drawable/bg_cyan_button_gradient"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.04"
                        android:text="DARSNI BOSHLASH"
                        android:textAllCaps="true"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenQuronWeb"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/day_segment_bg"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.04"
                        android:text="KUNLIK REJA"
                        android:textAllCaps="true"
                        android:textColor="@color/day_text_primary"
                        android:textSize="11sp"
                        app:cornerRadius="16dp"
                        app:strokeColor="@color/day_card_border"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <!-- Progress Bar: Bugungi dars: Fotiha -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvQuronLessonName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="Bugungi dars: Fotiha surasi"
                        android:textColor="@color/day_text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥 2h"
                        android:textColor="@color/day_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbQuronProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progress="45"
                    android:progressTint="@color/jarvis_cyan" />
            </LinearLayout>

            <!-- Dynamic Domain Quick Action Dock (Changes for every domain!) -->
            <HorizontalScrollView
                android:id="@+id/layoutDomainDockScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutDomainDock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipDomainAction1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ios_action_chip"
                        android:fontFamily="sans-serif-bold"
                        android:paddingStart="14dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="9dp"
                        android:text="📞 Onamga telefon"
                        android:textColor="@color/day_text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipDomainAction2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_ios_action_chip"
                        android:fontFamily="sans-serif-bold"
                        android:paddingStart="14dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="9dp"
                        android:text="💬 Telegram"
                        android:textColor="@color/day_text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipDomainAction3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_ios_action_chip"
                        android:fontFamily="sans-serif-bold"
                        android:paddingStart="14dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="9dp"
                        android:text="⏰ Eslatma"
                        android:textColor="@color/day_text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipDomainAction4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_ios_action_chip"
                        android:fontFamily="sans-serif-bold"
                        android:paddingStart="14dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="9dp"
                        android:text="⚡ Tizim holati"
                        android:textColor="@color/day_text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipInterrupt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_ios_action_chip"
                        android:fontFamily="sans-serif-bold"
                        android:paddingStart="12dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="9dp"
                        android:text="⏹ To'xtatish"
                        android:textColor="@color/jarvis_red"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- AI Kotib (Call Secretary) iOS Modern Card (Hidden by default to keep screen uncluttered) -->
            <LinearLayout
                android:id="@+id/cardAiSecretary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_day_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🤖"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvSecretaryTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:text="AI Kotib (Qo'ng'iroq Yordamchisi)"
                        android:textColor="@color/day_text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvSecretaryToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ios_action_chip"
                        android:fontFamily="sans-serif-bold"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="YOQILGAN"
                        android:textColor="@color/jarvis_accent"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSecretarySubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Siz band bo'lganingizda o'rningizga odob bilan javob beradi."
                    android:textColor="@color/day_text_secondary"
                    android:textSize="11sp" />

                <!-- Reason pills -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipReasonDars"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_ios_pill_active"
                            android:fontFamily="sans-serif-bold"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp"
                            android:text="📚 Darsdaman"
                            android:textColor="@color/night_pill_active_text"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/chipReasonMashina"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_ios_action_chip"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp"
                            android:text="🚗 Mashinadaman"
                            android:textColor="@color/day_text_primary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/chipReasonBand"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_ios_action_chip"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp"
                            android:text="💼 Bandman"
                            android:textColor="@color/day_text_primary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/chipReasonNamoz"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_ios_action_chip"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp"
                            android:text="🕌 Namozdaman"
                            android:textColor="@color/day_text_primary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/chipReasonCustom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_ios_action_chip"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp"
                            android:text="✍️ Boshqa..."
                            android:textColor="@color/day_text_primary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/tvSecretaryPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_ios_action_chip"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="💬 Assalomu alaykum. Axmadulloh sir hozir darsdalar, shuning uchun gaplasha olmadilar..."
                    android:textColor="@color/day_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Collapsible Live Activity HUD Card -->
            <LinearLayout
                android:id="@+id/cardLiveHud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_day_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Jonli Muloqot va Xabarlar"
                    android:textColor="@color/day_text_primary"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLiveFeed"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="6dp"
                    android:nestedScrollingEnabled="false"
                    android:scrollbars="vertical" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Command Input Bar (Fixed at Bottom, Matches Screenshot!) -->
    <LinearLayout
        android:id="@+id/bottomBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <!-- Rounded Pill Input Container -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_bottom_input_pill"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <EditText
                android:id="@+id/etCommandInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Buyruq yozing..."
                android:imeOptions="actionSend"
                android:inputType="text"
                android:textColor="@color/day_text_primary"
                android:textColorHint="@color/day_text_secondary"
                android:textSize="14sp" />
        </FrameLayout>

        <!-- Floating Circular Cyan Mic Button (Matches Screenshot!) -->
        <ImageButton
            android:id="@+id/btnSendCommand"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_circle_mic_cyan"
            android:contentDescription="Mikrofon"
            android:elevation="4dp"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_mic"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Hidden WebView for Web HUD / Quran Lesson -->
    <WebView
        android:id="@+id/webViewDashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerBar"
        android:visibility="gone" />

</RelativeLayout>
