<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 1. Fullscreen Living Particle Intelligence WebView (Hardware Accelerated uineyron.mp4 Canvas) -->
    <WebView
        android:id="@+id/webViewLivingParticle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF" />

    <!-- Fallback Native Particle View -->
    <com.jarvis.companion.ui.JarvisParticleView
        android:id="@+id/jarvisParticleView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 2. Minimalist Futuristic Top Bar (Always Visible) -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:visibility="visible">

        <!-- Brand Title: J · A · R · V · I · S -->
        <TextView
            android:id="@+id/tvBrandTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.18"
            android:singleLine="true"
            android:text="J · A · R · V · I · S"
            android:textColor="#0B2A18"
            android:textSize="14sp" />

        <!-- Status Indicator Pill: Eshitmoqdaman / Mikrofon o'chiq / Ulanmagan -->
        <TextView
            android:id="@+id/tvMicStatus"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/chipDomainSelector"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_caption_glass"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="● Eshitmoqdaman"
            android:textColor="#12A550"
            android:textSize="11.5sp"
            android:fontFamily="sans-serif-bold" />

        <!-- Domain Mode Selector Chip (Click opens Bottom Sheet) -->
        <LinearLayout
            android:id="@+id/chipDomainSelector"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_domain_chip"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp">

            <!-- Small Round Colored Indicator Dot -->
            <View
                android:id="@+id/viewChipDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_sheet_handle" />

            <!-- Active Domain Title (Short & Compact) -->
            <TextView
                android:id="@+id/tvChipTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:maxWidth="105dp"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Asosiy"
                android:textColor="#12A550"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 3. Mini Chat History Container (Last 2-3 exchanges) -->
    <LinearLayout
        android:id="@+id/layoutChatHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/cardCaptionContainer"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="6dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvHistoryItem1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:background="@drawable/bg_caption_glass"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="#64748B"
            android:textSize="11.5sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvHistoryItem2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_caption_glass"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="#0B2A18"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 4. Minimal Organic Status / Command Caption (Positioned ABOVE Text Input Bar) -->
    <LinearLayout
        android:id="@+id/cardCaptionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomBarContainer"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:alpha="0"
        android:background="@drawable/bg_caption_glass"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <!-- User Recognized Speech Transcript: "Eshitdim: ..." -->
        <TextView
            android:id="@+id/tvInputTranscript"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="2"
            android:text="Eshitdim: ..."
            android:textColor="#12A550"
            android:textSize="12.5sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvJarvisCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.01"
            android:lineSpacingExtra="3dp"
            android:maxLines="4"
            android:text="«Onamga telefon qil»"
            android:textColor="#1E293B"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 5. Always-Visible Text Input Bar (Kamida 16sp, klaviatura ustida adjustResize) -->
    <LinearLayout
        android:id="@+id/bottomBarContainer"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_sheet_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:visibility="visible">

        <EditText
            android:id="@+id/etCommandInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Buyruq yoki savol yozing..."
            android:imeOptions="actionSend"
            android:inputType="textCapSentences"
            android:textColor="#0B2A18"
            android:textColorHint="#94A3B8"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btnSendCommand"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Jo'natish"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_send"
            app:tint="#12A550" />
    </LinearLayout>

    <!-- 5. In-App Web View Container (Hidden by default, used for Quran recitation or web links) -->
    <RelativeLayout
        android:id="@+id/containerWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <RelativeLayout
            android:id="@+id/headerWebView"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#F8FAFC"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/tvWebTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="sans-serif-bold"
                android:text="Qur'on Ustozi"
                android:textColor="#0B2A18"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnOpenExternalBrowser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="Brauzerda ochish"
                    android:textColor="#12A550"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnCloseWebView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:padding="8dp"
                    android:text="Yopish ✕"
                    android:textColor="#64748B"
                    android:textSize="12sp" />
            </LinearLayout>
        </RelativeLayout>

        <WebView
            android:id="@+id/webViewDashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/headerWebView" />
    </RelativeLayout>

</RelativeLayout>
