<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 1. Fullscreen Living Particle Intelligence WebView (Hardware Accelerated uineyron.mp4 Canvas) -->
    <WebView
        android:id="@+id/webViewLivingParticle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF" />

    <!-- Fallback Native Particle View -->
    <com.jarvis.companion.ui.JarvisParticleView
        android:id="@+id/jarvisParticleView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 2. Minimalist Futuristic Top Bar (Always Visible) -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:visibility="visible">

        <!-- Brand Title: J · A · R · V · I · S -->
        <TextView
            android:id="@+id/tvBrandTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.18"
            android:singleLine="true"
            android:text="J · A · R · V · I · S"
            android:textColor="#0B2A18"
            android:textSize="14sp" />

        <!-- Domain Mode Selector Chip (Click opens Bottom Sheet) -->
        <LinearLayout
            android:id="@+id/chipDomainSelector"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_domain_chip"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp">

            <!-- Small Round Colored Indicator Dot -->
            <View
                android:id="@+id/viewChipDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_sheet_handle" />

            <!-- Active Domain Title (Short & Compact) -->
            <TextView
                android:id="@+id/tvChipTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:maxWidth="105dp"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Asosiy"
                android:textColor="#12A550"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Center reference anchor for the living particle Orb -->
    <View
        android:id="@+id/orbCenterAnchor"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_centerInParent="true"
        android:visibility="invisible" />

    <!-- Clean Center Info Container directly under the Orb (No bulky cards, no overlapping views) -->
    <LinearLayout
        android:id="@+id/layoutCenterInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/orbCenterAnchor"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="48dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Single subtle status badge: ● Eshitmoqdaman / ● O'ylayapman / 🔊 Gapiryapman -->
        <TextView
            android:id="@+id/tvMicStatus"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_caption_glass"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="● Eshitmoqdaman"
            android:textColor="#12A550"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold" />

        <!-- User Recognized Speech Transcript: Very small, muted gray, 1 line -->
        <TextView
            android:id="@+id/tvInputTranscript"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:maxLines="1"
            android:singleLine="true"
            android:text=""
            android:textColor="#64748B"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Jarvis Response Caption: 1-2 lines, 15sp, muted/clean, smoothly fades in/out -->
        <TextView
            android:id="@+id/tvJarvisCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.01"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:text=""
            android:textColor="#1E293B"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Always-Visible Text Input Bar (Kamida 52dp balandlik, 16sp matn, klaviatura ustida adjustResize) -->
    <LinearLayout
        android:id="@+id/bottomBarContainer"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_sheet_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="visible">

        <!-- History Button (Opens pull-up Bottom Sheet for full conversation) -->
        <ImageButton
            android:id="@+id/btnChatHistory"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Suhbat tarixi"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_history"
            app:tint="#64748B" />

        <EditText
            android:id="@+id/etCommandInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@null"
            android:hint="Buyruq yoki savol yozing..."
            android:imeOptions="actionSend"
            android:inputType="textCapSentences"
            android:textColor="#0B2A18"
            android:textColorHint="#94A3B8"
            android:textSize="16sp" />

        <!-- Microphone toggle button -->
        <ImageButton
            android:id="@+id/btnToggleMic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Mikrofon"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_mic"
            app:tint="#12A550" />

        <!-- Send button -->
        <ImageButton
            android:id="@+id/btnSendCommand"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Jo'natish"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_send"
            app:tint="#12A550" />
    </LinearLayout>

    <!-- 5. In-App Web View Container (Hidden by default, used for Quran recitation or web links) -->
    <RelativeLayout
        android:id="@+id/containerWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <RelativeLayout
            android:id="@+id/headerWebView"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#F8FAFC"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/tvWebTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="sans-serif-bold"
                android:text="Qur'on Ustozi"
                android:textColor="#0B2A18"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnOpenExternalBrowser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="Brauzerda ochish"
                    android:textColor="#12A550"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnCloseWebView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:padding="8dp"
                    android:text="Yopish ✕"
                    android:textColor="#64748B"
                    android:textSize="12sp" />
            </LinearLayout>
        </RelativeLayout>

        <WebView
            android:id="@+id/webViewDashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/headerWebView" />
    </RelativeLayout>

</RelativeLayout>
