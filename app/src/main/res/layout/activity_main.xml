<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night_bg">

    <!-- Top iOS-style Minimal Header Bar -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="26dp"
            android:layout_height="26dp"
            app:srcCompat="@drawable/ic_jarvis"
            app:tint="@color/jarvis_cyan" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.12"
            android:text="J.A.R.V.I.S"
            android:textColor="@color/night_text_primary"
            android:textSize="18sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Status Pill Badge -->
        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ios_action_chip"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="● ULANGAN"
            android:textColor="@color/jarvis_accent"
            android:textSize="11sp" />

        <!-- Day/Night Auto-Theme Toggle Button -->
        <ImageButton
            android:id="@+id/btnThemeToggle"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Mavzu"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_moon" />

        <!-- Settings Cog Button -->
        <ImageButton
            android:id="@+id/btnOpenSettings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Sozlamalar"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_jarvis"
            app:tint="@color/night_text_secondary" />
    </LinearLayout>

    <!-- 3-Way Device Route Selector (iOS Capsule Segmented Control) -->
    <LinearLayout
        android:id="@+id/layoutSegmentBar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_below="@id/headerBar"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_ios_segment_bar"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/btnRoutePc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="💻 Kompyuter"
            android:textColor="@color/night_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/btnRoutePhone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📱 Telefon"
            android:textColor="@color/night_text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/btnRouteEarbuds"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_ios_pill_active"
            android:gravity="center"
            android:text="🎧 Quloqchin"
            android:textColor="@color/night_pill_active_text"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold" />
    </LinearLayout>

    <!-- Scrollable Center & Bottom Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutSegmentBar"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Center AI Arena: Glowing Jarvis Orb -->
            <FrameLayout
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:layout_marginTop="4dp">

                <com.jarvis.companion.ui.JarvisOrbView
                    android:id="@+id/jarvisOrb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <!-- Minimalist AI Status Text -->
            <TextView
                android:id="@+id/tvOrbStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:text="JARVIS TAYYOR"
                android:textColor="@color/jarvis_cyan"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvOrbSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Labbay, Axmadulloh sir, eshitaman..."
                android:textColor="@color/night_text_secondary"
                android:textSize="13sp" />

            <!-- Quick Action Shortcut Chips (Horizontal Scroll) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipCallMom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ios_action_chip"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="14dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="8dp"
                        android:text="📞 Onamga telefon"
                        android:textColor="@color/night_text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipReadTelegram"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_ios_action_chip"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="14dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="8dp"
                        android:text="💬 Telegram xabarlari"
                        android:textColor="@color/night_text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipSetReminder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_ios_action_chip"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="14dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="8dp"
                        android:text="⏰ Eslatma qo'yish"
                        android:textColor="@color/night_text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipInterrupt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_ios_action_chip"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="14dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="8dp"
                        android:text="⏹ To'xtatish"
                        android:textColor="@color/jarvis_red"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Quran Lesson iOS Modern Card -->
            <LinearLayout
                android:id="@+id/cardQuronLesson"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_ios_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        app:srcCompat="@drawable/ic_quron" />

                    <TextView
                        android:id="@+id/tvQuronTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:text="Qur'on Ustozi AI"
                        android:textColor="@color/night_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvQuronBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ios_action_chip"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="TAYYOR"
                        android:textColor="@color/jarvis_accent"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvQuronInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Darsni boshlang: qori qiroatini quloqchinda eshitasiz va mashq qilasiz."
                    android:textColor="@color/night_text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartQuron"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/jarvis_accent"
                        android:fontFamily="sans-serif-bold"
                        android:text="▶ Darsni boshlash"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenQuronWeb"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/night_segment_bg"
                        android:fontFamily="sans-serif-medium"
                        android:text="📖 Dars oynasi"
                        android:textAllCaps="false"
                        android:textColor="@color/night_text_primary"
                        android:textSize="12sp"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/night_card_border"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Collapsible Live Activity HUD Card -->
            <LinearLayout
                android:id="@+id/cardLiveHud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_ios_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Jonli Muloqot"
                    android:textColor="@color/night_text_primary"
                    android:textSize="13sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLiveFeed"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    android:scrollbars="vertical" />

                <!-- Text command row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etCommandInput"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ios_action_chip"
                        android:hint="Buyruq yozing..."
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/night_text_primary"
                        android:textColorHint="@color/night_text_secondary"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btnSendCommand"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_ios_pill_active"
                        android:contentDescription="Yuborish"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ic_mic"
                        app:tint="@color/night_pill_active_text" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Hidden WebView for Web HUD / Quran Lesson -->
    <WebView
        android:id="@+id/webViewDashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerBar"
        android:visibility="gone" />

</RelativeLayout>
