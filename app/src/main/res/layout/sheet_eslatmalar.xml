<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏰ Eslatmalar"
        android:textSize="18sp"
        android:fontFamily="sans-serif-black"
        android:textColor="#0B2A18"
        android:layout_marginBottom="4dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddReminderFromSheet"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:text="+ Yangi Eslatma"
        app:cornerRadius="14dp" />

    <TextView
        android:id="@+id/tvRemindersEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hali eslatmalar yo'q. Jarvisga ovoz bilan ham aytishingiz mumkin!"
        android:textColor="#94A3B8"
        android:gravity="center"
        android:padding="20dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReminderList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false" />

</LinearLayout>
