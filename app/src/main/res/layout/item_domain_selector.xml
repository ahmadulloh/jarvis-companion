<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/containerDomainItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_ios_action_chip"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Row: Icon + Title + Category + Active Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Domain Icon Circle -->
        <FrameLayout
            android:id="@+id/layoutDomainIconCircle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_avatar">

            <TextView
                android:id="@+id/tvDomainIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="⚡"
                android:textSize="20sp" />
        </FrameLayout>

        <!-- Title & Category -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDomainTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Soha Nomi"
                android:textColor="@color/night_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvDomainCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Kategoriya"
                android:textColor="@color/jarvis_cyan"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Activate Button / Active Check -->
        <TextView
            android:id="@+id/tvDomainBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_ios_pill_active"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:text="TANLASH"
            android:textColor="@color/night_pill_active_text"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Description of enhanced features -->
    <TextView
        android:id="@+id/tvDomainDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:text="Kuchaytirilgan funksiyalar va eslatmalar ro'yxati..."
        android:textColor="@color/night_text_secondary"
        android:textSize="11sp" />
</LinearLayout>
