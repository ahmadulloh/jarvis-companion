<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top_rounded"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="28dp">

    <!-- Top Handle Bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_sheet_handle" />

    <!-- Sheet Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvSheetHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.22"
            android:text="YO'NALISHNI TANLANG"
            android:textColor="#5D7A69"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btnSheetSettings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Sozlamalar"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_settings"
            app:tint="#5D7A69" />
    </RelativeLayout>

    <!-- Search Input (Initially hidden, shown when search is expanded) -->
    <EditText
        android:id="@+id/etDomainSearch"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_sheet_search"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="10dp"
        android:fontFamily="sans-serif"
        android:hint="Sohani qidirish..."
        android:imeOptions="actionDone"
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#0B2A18"
        android:textColorHint="#94A3B8"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- 3-Column Domain Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDomainsGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never" />

    <!-- "+ yana 26 ta yo'nalish · qidirish" Toggle Button (Hidden: Only Yurist & Din modes) -->
    <TextView
        android:id="@+id/btnExpandAllDomains"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>
