<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:background="@drawable/bg_settings_dialog_light"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_avatar"
            android:gravity="center"
            android:text="⏰"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Eslatma o'rnatish"
                android:textColor="#0F172A"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="JARVIS sizga o'z vaqtida eslatadi"
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCancelReminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="✕"
            android:textColor="#94A3B8"
            android:textSize="16sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="#F1F5F9" />

    <!-- Label Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:fontFamily="sans-serif-medium"
        android:text="Eslatma matni"
        android:textColor="#334155"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etReminderTitle"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_settings_input"
        android:hint="Masalan: Darsga borish"
        android:inputType="textCapSentences"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#0F172A"
        android:textColorHint="#94A3B8"
        android:textSize="13.5sp" />

    <!-- Time Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:fontFamily="sans-serif-medium"
        android:text="Vaqti yoki daqiqasi"
        android:textColor="#334155"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etReminderTime"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_settings_input"
        android:hint="Masalan: 10 daqiqa yoki 08:30"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#0F172A"
        android:textColorHint="#94A3B8"
        android:textSize="13.5sp" />

    <!-- Save Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveReminder"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#12A550"
        android:fontFamily="sans-serif-bold"
        android:text="Eslatmani saqlash"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:cornerRadius="12dp" />

</LinearLayout>
